# Contoh reverse proxy Nginx dengan HTTP Basic Auth di depan dashboard.
#
# Dashboard aplikasi ini TIDAK punya autentikasi. Reverse proxy inilah yang
# menambahkan lapisan login sederhana + (opsional) HTTPS.
#
# Setup:
#   1. Install nginx & apache2-utils (untuk htpasswd):
#        sudo apt install nginx apache2-utils
#   2. Buat file password:
#        sudo htpasswd -c /etc/nginx/.htpasswd admin
#   3. Salin file ini ke /etc/nginx/sites-available/monitoring, sesuaikan
#      server_name, lalu aktifkan:
#        sudo ln -s /etc/nginx/sites-available/monitoring /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#   4. (Disarankan) pasang HTTPS gratis dengan certbot:
#        sudo apt install certbot python3-certbot-nginx
#        sudo certbot --nginx -d monitoring.contohdomain.com

server {
    listen 80;
    server_name monitoring.contohdomain.com;  # ganti dengan domain/IP kamu

    # Batasi ukuran body (form kecil saja).
    client_max_body_size 1m;

    location / {
        # Autentikasi login sederhana.
        auth_basic "Monitoring Dashboard";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
